{
  "name": "@adjoin/tokens",
  "version": "0.1.0",
  "description": "Adjoin design tokens: DTCG 2025.10 source, CSS + TypeScript outputs, and a CI gate for data-dense analytics UI.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "build": "node scripts/build.mjs",
    "build:lenient": "node scripts/build.mjs --lenient",
    "lint:css": "node scripts/lint-css-vars.mjs examples",
    "typecheck": "tsc -p examples/dashboard",
    "test": "node --test test/*.test.mjs",
    "check": "npm run validate && npm run build && npm run lint:css && npm run typecheck && npm run typecheck:components && npm test",
    "learn": "node scripts/build.mjs > /dev/null && tsc -p learn",
    "typecheck:components": "tsc -p src",
    "storybook": "node scripts/build.mjs > /dev/null && storybook dev -p 6006 --no-open",
    "build-storybook": "node scripts/build.mjs > /dev/null && storybook build"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "10.6",
    "typescript": "^5.6.0",
    "vite": "^8.3.0"
  }
}
